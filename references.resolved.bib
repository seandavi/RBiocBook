@article{doi:10.1093/bioinformatics/btac582,
  author = {Phipson, Belinda and Sim, Choon Boon and Porrello, Enzo R
    and Hewitt, Alex W and Powell, Joseph and Oshlack, Alicia},
  editor = {Mathelier, Anthony},
  publisher = {Oxford University Press (OUP)},
  title = {\emph{Propeller:} testing for Differences in Cell Type
    Proportions in Single Cell Data},
  journal = {Bioinformatics},
  volume = {38},
  number = {20},
  pages = {4720-4726},
  date = {2022-08-25},
  url = {https://doi.org/gs7zd5},
  doi = {10.1093/bioinformatics/btac582},
  note = {This CSL Item was generated by Manubot v0.6.1 from its
    persistent identifier (standard\_id). standard\_id:
    doi:10.1093/bioinformatics/btac582},
  langid = {en},
  abstract = {\textless jats:title\textgreater
    Abstract\textless/jats:title\textgreater{} \textless
    jats:sec\textgreater{} \textless jats:title\textgreater
    Motivation\textless/jats:title\textgreater{} \textless
    jats:p\textgreater Single cell RNA-Sequencing (scRNA-seq) has
    rapidly gained popularity over the last few years for profiling the
    transcriptomes of thousands to millions of single cells. This
    technology is now being used to analyse experiments with complex
    designs including biological replication. One question that can be
    asked from single cell experiments, which has been difficult to
    directly address with bulk RNA-seq data, is whether the cell type
    proportions are different between two or more experimental
    conditions. As well as gene expression changes, the relative
    depletion or enrichment of a particular cell type can be the
    functional consequence of disease or treatment. However, cell type
    proportion estimates from scRNA-seq data are variable and
    statistical methods that can correctly account for different sources
    of variability are needed to confidently identify statistically
    significant shifts in cell type composition between experimental
    conditions.\textless/jats:p\textgreater{}
    \textless/jats:sec\textgreater{} \textless jats:sec\textgreater{}
    \textless jats:title\textgreater
    Results\textless/jats:title\textgreater{} \textless
    jats:p\textgreater We have developed propeller, a robust and
    flexible method that leverages biological replication to find
    statistically significant differences in cell type proportions
    between groups. Using simulated cell type proportions data, we show
    that propeller performs well under a variety of scenarios. We
    applied propeller to test for significant changes in cell type
    proportions related to human heart development, ageing and COVID-19
    disease severity.\textless/jats:p\textgreater{}
    \textless/jats:sec\textgreater{} \textless jats:sec\textgreater{}
    \textless jats:title\textgreater Availability and
    implementation\textless/jats:title\textgreater{} \textless
    jats:p\textgreater The propeller method is publicly available in the
    open source speckle R package
    (https://github.com/phipsonlab/speckle). All the analysis code for
    the article is available at the associated analysis website:
    https://phipsonlab.github.io/propeller-paper-analysis/. The speckle
    package, analysis scripts and datasets have been deposited at
    https://doi.org/10.5281/zenodo.7009042.\textless/jats:p\textgreater{}
    \textless/jats:sec\textgreater{} \textless jats:sec\textgreater{}
    \textless jats:title\textgreater Supplementary
    information\textless/jats:title\textgreater{} \textless
    jats:p\textgreater Supplementary data are available at
    Bioinformatics online.\textless/jats:p\textgreater{}
    \textless/jats:sec\textgreater{}}
}
