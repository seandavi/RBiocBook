<mxfile host="rbiocbook">
  <diagram name="gene-activity" id="ga">
    <mxGraphModel dx="900" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Estimating gene activity: crediting a gene for nearby open chromatin" style="text;html=1;align=center;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="680" height="24" as="geometry"/></mxCell>
        <mxCell id="clbl" value="(C) Cicero: link distal enhancer to the promoter via co-accessibility" style="text;html=1;align=center;fontSize=11;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="350" y="64" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="tss" value="TSS" style="text;html=1;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="160" y="108" width="60" height="16" as="geometry"/></mxCell>
        <mxCell id="axis" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="152" as="sourcePoint"/><mxPoint x="710" y="152" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="prom" value="promoter&#10;(−2 kb)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="134" width="60" height="36" as="geometry"/></mxCell>
        <mxCell id="gene" value="gene body" style="shape=singleArrow;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arrowWidth=0.55;arrowSize=0.2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="134" width="180" height="36" as="geometry"/></mxCell>
        <mxCell id="pklbl" value="ATAC peaks" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="186" width="80" height="18" as="geometry"/></mxCell>
        <mxCell id="p1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="166" y="188" width="48" height="16" as="geometry"/></mxCell>
        <mxCell id="p2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="188" width="48" height="16" as="geometry"/></mxCell>
        <mxCell id="p3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="334" y="188" width="40" height="16" as="geometry"/></mxCell>
        <mxCell id="p4" value="distal enhancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="590" y="186" width="96" height="20" as="geometry"/></mxCell>
        <mxCell id="brkbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="158" y="182" width="224" height="28" as="geometry"/></mxCell>
        <mxCell id="abl" value="(A) gene body + promoter — sum these peaks (the score used in this chapter)" style="text;html=1;align=center;fontSize=11;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="224" width="380" height="20" as="geometry"/></mxCell>
        <mxCell id="bbl" value="(B) ArchR: weight every peak by distance from the TSS — the distal enhancer still counts, but less" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="258" width="540" height="20" as="geometry"/></mxCell>
        <mxCell id="arc" style="endArrow=classic;html=1;dashed=1;strokeColor=#9673a6;rounded=1;curved=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="100"/></Array></mxGeometry></mxCell>
        <mxCell id="score" value="gene activity score&#10;(one value per gene, per cell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="toscore" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="brkbox" target="score"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="foot" value="All three credit a gene for the open chromatin around it; they differ in how far the neighborhood reaches and how the credit decays with distance." style="text;html=1;align=center;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="680" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
