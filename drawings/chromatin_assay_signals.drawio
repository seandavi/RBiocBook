        <!-- ===== gene model at top ===== -->
        <mxCell id="genome_line" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="80" as="sourcePoint"/><mxPoint x="720" y="80" as="targetPoint"/></mxGeometry></mxCell>
        <!-- gene body box -->
