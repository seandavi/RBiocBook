        <mxCell id="t2_lab" value="&lt;b&gt;DNase-seq&lt;/b&gt;&lt;br&gt;(open chromatin;&lt;br&gt;more input DNA)" style="text;html=1;align=left;fontSize=11;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="150" height="50" as="geometry"/></mxCell>
