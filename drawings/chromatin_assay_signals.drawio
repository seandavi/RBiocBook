        <mxCell id="t3_peak3" value="" style="triangle;html=1;direction=north;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="328" width="28" height="22" as="geometry"/></mxCell>

