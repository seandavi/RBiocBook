        <!-- ===== Track 1: ChIP-seq ===== -->
        <mxCell id="t1_lab" value="&lt;b&gt;ChIP-seq&lt;/b&gt;&lt;br&gt;(one protein:&lt;br&gt;TF or histone mark)" style="text;html=1;align=left;fontSize=11;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="50" as="geometry"/></mxCell>
